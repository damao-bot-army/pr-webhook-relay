{
  "name": "pr-webhook-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [ -z \"$(git rev-parse --show-prefix)\" ] && git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  }
}
